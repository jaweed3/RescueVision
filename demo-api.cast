[0.000, "o", "  RescueVision Edge — API Demo\r\n==============================================\r\n\r\n"]
[1.003, "o", "▶ 1. OpenAPI Schema (all endpoints)\r\n\r\n"]
[0.341, "o", "{\r\n    \"openapi\": \"3.1.0\",\r\n    \"info\": {\r\n        \"title\": \"RescueVision Edge API\",\r\n        \"description\": \"Lightweight on-device victim detection for post-disaster SAR\",\r\n        \"version\": \"1.0.0\"\r\n    },\r\n    \"paths\": {\r\n        \"/health\": {\r\n            \"get\": {\r\n                \"summary\": \"Health Check\",\r\n                \"description\": \"System health check \\u2014 exactly as requested.\",\r\n                \"operationId\": \"health_check_health_get\",\r\n                \"responses\": {\r\n                    \"200\": {\r\n                        \"description\": \"Successful Response\",\r\n                        \"content\": {\r\n                            \"application/json\": {\r\n                                \"schema\": {}\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        },\r\n        \"/detect\": {\r\n            \"post\": {\r\n                \"summary\": \"Detect Single\",\r\n                \"description\": \"Detect victims in a single drone image.\",\r\n               "]
[0.000, "o", " \"operationId\": \"detect_single_detect_post\",\r\n                \"parameters\": [\r\n                    {\r\n                        \"name\": \"manual_lat\",\r\n                        \"in\": \"query\",\r\n                        \"required\": false,\r\n                        \"schema\": {\r\n                            \"anyOf\": [\r\n                                {\r\n                                    \"type\": \"number\"\r\n                                },\r\n"]
[0.000, "o", "                                {\r\n                                    \"type\": \"null\"\r\n"]
[0.000, "o", "                                }\r\n                            ],\r\n"]
[0.000, "o", "                            \"title\": \"Manual Lat\"\r\n                        }\r\n"]
[0.000, "o", "                    },\r\n                    {\r\n"]
[0.000, "o", "                        \"name\": \"manual_lon\",\r\n                        \"in\": \"query\",\r\n"]
